# Copy to .env (gitignored) and fill in. Never commit real keys.

# Backend
ANTHROPIC_API_KEY=
# Where a study session's parts come from: "sample" (free, the default) or
# "agent" (built by Claude; each session costs money and needs the key above).
SESSION_SOURCE=sample
# Claude model for the session agent. Empty uses claude-opus-5-5.
LLM_MODEL=
# How hard the model works: low, medium, high, xhigh or max. Empty uses high.
LLM_EFFORT=
WHISPER_MODEL=small
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where study sessions are saved (relative paths are from the repo root), and how many
# days a session nobody has touched is kept. Empty uses data/lumen.db and 30.
SESSIONS_DB=
SESSION_DAYS=
FRONTEND_ORIGIN=http://localhost:5173

# Frontend (Vite only exposes variables prefixed with VITE_)
VITE_API_BASE=http://localhost:8000
